{
  "name": "fetchy-api",
  "version": "1.0.0",
  "description": "Video download API for Fetchy iOS app using yt-dlp",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "postinstall": "curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux -o yt-dlp && chmod a+rx yt-dlp"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.17.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ffmpeg-static": "^5.2.0",
    "youtube-dl-exec": "^2.5.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
